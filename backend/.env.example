# Reference only: this backend does not automatically load .env files.
# Set these variables in the shell before starting Uvicorn (see README.md).
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Observation threshold for data_status only; no recommendation logic. 30/60/90.
USAGE_EVALUATION_DAYS=30
# Optional. If omitted, the database is subscriptions.db in the project root.
# SUBSCRIPTION_DB_PATH=C:/path/to/subscriptions.db
